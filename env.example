# Clerk — https://dashboard.clerk.com (use Production instance keys on Vercel)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_AUTHORIZED_PARTY=https://shotfarm.io

# Neon — https://console.neon.tech  (Vercel Neon integration may set POSTGRES_URL instead)
DATABASE_URL=
# POSTGRES_URL=  # optional fallback; lib/db reads this if DATABASE_URL is empty

# Stripe — Live mode for production
# Webhook endpoint: https://shotfarm.io/api/stripe-webhook
# Required events: checkout.session.completed, invoice.paid
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fal
FAL_KEY=
# Run 2 passes and keep the last result — improves first-hit quality (default 2).
FAL_MAX_ATTEMPTS=2

# Coming soon / waitlist
# Set VITE_COMING_SOON=false for public launch (requires Vercel redeploy).
VITE_COMING_SOON=false
WAITLIST_WEBHOOK_URL=

# Local dev: copy this file to .env.local, set VITE_COMING_SOON=false and FAL_KEY.
# Paywall is off in lib/billing.ts; vite dev serves /api/* via vite.api-dev.ts.
